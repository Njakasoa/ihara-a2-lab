#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
SAGE_PREFIX=${SAGE_PREFIX:-"$ROOT/.runtime/sage"}
DOT_SAGE=${DOT_SAGE:-"$ROOT/.runtime/sage-home"}

if [[ ! -x "$SAGE_PREFIX/bin/python" ]]; then
    printf 'Sage Python not found; expected %s\n' "$SAGE_PREFIX/bin/python" >&2
    exit 127
fi

mkdir -p "$DOT_SAGE"
export DOT_SAGE
export PYTHONNOUSERSITE=${PYTHONNOUSERSITE:-1}
exec "$SAGE_PREFIX/bin/python" "$@"
